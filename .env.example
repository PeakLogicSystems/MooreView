PORT=3100
NODE_ENV=development

# Cloud multitenant service (npm start). IoT devices use MQTT only; field buses run on est-pc edge.
MOOREVIEW_DEPLOYMENT=cloud

# Database — Azure DocumentDB (MongoDB vCore) in production; local MongoDB for dev
# Production URI is set automatically by azure/main.bicep
# DOCUMENTDB_URI=mongodb+srv://mvadmin:PASSWORD@CLUSTER.mongocluster.cosmos.azure.com/?tls=true&authMechanism=SCRAM-SHA-256&retrywrites=false&maxIdleTimeMS=120000
DOCUMENTDB_ENABLED=false
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=mooreview_cloud

# JWT signing secret — change in production (local dev default set by npm run seed if missing)
JWT_SECRET=mooreview-jwt-dev-local-only
JWT_EXPIRES_IN=7d

# Hierarchy limits (defaults match product spec)
MAX_LOCATIONS_PER_TENANT=1000
MAX_SYSTEMS_PER_LOCATION=1000
MAX_DEVICES_PER_SYSTEM=1000

# Platform super-admin key — local dev default set by npm run seed if missing
# Used at /admin/login and PATCH /api/admin/tenants/:id/cmms
PLATFORM_ADMIN_KEY=mooreview-platform-dev

# Azure Service Bus (cloud alarm pipeline — optional locally)
# SERVICE_BUS_CONNECTION_STRING=Endpoint=sb://...
# SERVICE_BUS_NAMESPACE=mooreview-sb-xxx   # managed identity fallback (Azure only)
# SERVICE_BUS_QUEUE_ALARM_TRANSITIONS=alarm-transitions
# SERVICE_BUS_QUEUE_ALARM_NOTIFY=alarm-notify
# SERVICE_BUS_QUEUE_CMMS_ALARMS=cmms-alarms
# SERVICE_BUS_QUEUE_PARC_INGEST=parc-ingest
