# MooreVIEW IoT-Link generic appliance
# Installed to /etc/mooreview/env by deploy/iot-link/install-generic.sh

PORT=3090
MOOREVIEW_PORT=3090
MOOREVIEW_DEPLOYMENT=appliance
MOOREVIEW_PRODUCT=iot-link
MOOREVIEW_TENANT_ID=local
MOOREVIEW_DATA=/var/lib/mooreview

# Compulab IOT-LINK RS-485 (FARS4=PORT A, FBRS4=PORT B)
MOOREVIEW_RS485_PORT_A=/dev/ttyLP6
MOOREVIEW_RS485_PORT_B=/dev/ttyLP4

# Single-tenant login (seeded on first boot)
# Default admin: admin@local / ChangeMeAdmin!
# Default operator: operator@local / operator

# MongoDB (install.sh provisions local mongod)
MONGO_URL=mongodb://127.0.0.1:27017/mooreview
MONGODB_URI=mongodb://127.0.0.1:27017/mooreview
MOOREVIEW_CONFIG_URI=mongodb://127.0.0.1:27017/mooreview
MOOREVIEW_CONFIG_DB=mooreview_config
MONGODB_DB=mooreview

MOSQUITTO_ALLOW_ANONYMOUS=false
MOSQUITTO_USER=
MOSQUITTO_PASS=

# Optional cloud uplink — System setup → Cloud remote
# cloudRemote.enabled=true
