# MooreVIEW MVP Suite — Windows PC appliance
# Copy to .env in the install folder (build-appliance does this automatically)

PORT=3090
MOOREVIEW_PORT=3090
MOOREVIEW_PRODUCT=mvp-suite
MOOREVIEW_DEPLOYMENT=appliance
MOOREVIEW_TENANT_ID=local
MOOREVIEW_DATA=./data

# Single-tenant login (seeded on first boot — change passwords in production)
# Default admin: admin@local / ChangeMeAdmin!
# Default operator: operator@local / operator

# MongoDB optional — historian + config store (recommended on PC)
MOOREVIEW_CONFIG_URI=mongodb://127.0.0.1:27017
MOOREVIEW_CONFIG_DB=mooreview_config
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=mooreview
MONGODB_COLLECTION=tag_logs

# Optional MQTT Parc (local Mosquitto or npm run mqtt:start)
# MOOREVIEW_MQTT_BROKER=mqtt://127.0.0.1:1883
