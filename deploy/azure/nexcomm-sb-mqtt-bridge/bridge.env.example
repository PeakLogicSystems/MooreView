# /etc/mooreview/nexcomm-bridge.env — copy from services/nexcomm-sb-mqtt-bridge/.env.example

SERVICE_BUS_CONNECTION_STRING=Endpoint=sb://YOUR_NAMESPACE.servicebus.windows.net/;SharedAccessKeyName=bridge-listen;SharedAccessKey=...
SERVICE_BUS_QUEUE=nexcomm-telemetry

MQTT_BROKER_URL=mqtt://127.0.0.1:1883
MQTT_USERNAME=mooreview
MQTT_PASSWORD=change-me

MQTT_EVENTS_TOPIC_TEMPLATE=/devices/{serial}/messages/events/
BRIDGE_MAX_CONCURRENT=8
