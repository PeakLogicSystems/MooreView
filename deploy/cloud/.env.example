# MooreVIEW cloud VM — environment (copy to `.env`)

# App
MOOREVIEW_PORT=3090
MOOREVIEW_DEPLOYMENT=cloud
MOOREVIEW_TENANT_ID=local

# MongoDB (docker-compose service name `mongodb`; not exposed on host by default)
MONGODB_URI=mongodb://mongodb:27017
MOOREVIEW_CONFIG_URI=mongodb://mongodb:27017
MOOREVIEW_CONFIG_DB=mooreview_config
MONGODB_DB=mooreview

# MQTT broker (docker-compose service `mosquitto`; port 1883 published for Opta/appliances)
MOOREVIEW_MQTT_BROKER=mqtt://mosquitto:1883

# Mosquitto auth (default: credentials required; set MOSQUITTO_ALLOW_ANONYMOUS=true for dev)
MOSQUITTO_ALLOW_ANONYMOUS=false
MOSQUITTO_USER=mooreview
MOSQUITTO_PASS=change-me
# MOSQUITTO_TLS=true
# MOSQUITTO_TLS_PORT=8883

# Pass same credentials to mooreview hub when auth enabled (System setup → MQTT Parc username/password)
# mqttParc.username=mooreview
# mqttParc.password=change-me

# Optional auth (leave empty for anonymous Mosquitto in dev)
# MOOREVIEW_TOKEN=

# Historian (optional — configure in UI or override here)
# MONGODB_COLLECTION=tag_logs
# MONGODB_EDGE_COLLECTION=edge_inference
# MONGODB_SAMPLE_MS=5000

# Site appliance uplink (configure on each MooreVIEW appliance, not usually on cloud VM)
# cloudRemote.enabled=true
# cloudRemote.tenantId=<from pairing>
# cloudRemote.gatewayId=<appliance uuid>
# cloudRemote.brokerUrl=mqtt://<droplet-ip>:1883

# Cellular SIM management (enabled by default when MOOREVIEW_DEPLOYMENT=cloud)
# MOOREVIEW_CELLULAR_SIMS=1

# NextCentury cloud hub — 15 sites × 1500 devices auto-sync (3 tags/device + status).
# Default when MOOREVIEW_DEPLOYMENT=cloud and unset: 70912. Override only if your fleet differs.
# MOOREVIEW_MAX_TAGS=70912
