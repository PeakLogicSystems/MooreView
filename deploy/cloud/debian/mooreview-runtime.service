[Unit]
Description=MooreVIEW edge runtime (port 3090 — optional client/appliance API hub)
Documentation=https://github.com/your-org/mooreview
After=network-online.target mongod.service mosquitto.service mooreview-saas.service
Wants=network-online.target
Requires=mongod.service mosquitto.service

[Service]
Type=simple
User=mooreview
Group=mooreview
WorkingDirectory=@MOOREVIEW_INSTALL_DIR@
EnvironmentFile=-/etc/mooreview/runtime.env
Environment=NODE_OPTIONS=
Environment=NODE_ENV=production
Environment=MOOREVIEW_DEPLOYMENT=cloud
Environment=MOOREVIEW_PRODUCT=cloud
Environment=PORT=3090
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=false
ReadWritePaths=/var/lib/mooreview @MOOREVIEW_INSTALL_DIR@
PrivateTmp=true

[Install]
WantedBy=multi-user.target
