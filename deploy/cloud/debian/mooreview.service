[Unit]
Description=MooreVIEW Cloud Appliance
After=network.target mongod.service mosquitto.service

[Service]
Type=simple
User=mooreview
Group=mooreview
WorkingDirectory=@MOOREVIEW_INSTALL_DIR@
EnvironmentFile=/etc/mooreview/env
Environment=NODE_ENV=production
Environment=MOOREVIEW_DEPLOYMENT=cloud
Environment=MOOREVIEW_PRODUCT=mvp-suite
Environment=MOOREVIEW_DATA=/var/lib/mooreview
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
