# MooreVIEW SaaS — copied to /etc/mooreview/saas.env on first install-saas.sh.
# Edit MOSQUITTO_PASS before production, then re-run install-saas.sh.

PORT=3100
MOOREVIEW_PORT=3100
MOOREVIEW_DEPLOYMENT=cloud
MOOREVIEW_PRODUCT=mvp-suite
MOOREVIEW_DATA=/var/lib/mooreview

# Seeded on first boot (change in production)
MOOREVIEW_SEED_TENANT=demo
MOOREVIEW_SEED_ADMIN_EMAIL=admin@demo.local
MOOREVIEW_SEED_ADMIN_PASSWORD=ChangeMeAdmin!
MOOREVIEW_SEED_OPERATOR_EMAIL=operator@demo.local
MOOREVIEW_SEED_OPERATOR_PASSWORD=demo

MONGO_URL=mongodb://127.0.0.1:27017/mooreview
MONGODB_URI=mongodb://127.0.0.1:27017/mooreview
MOOREVIEW_CONFIG_URI=mongodb://127.0.0.1:27017/mooreview
MOOREVIEW_CONFIG_DB=mooreview_config
MONGODB_DB=mooreview

MOOREVIEW_MQTT_BROKER=mqtt://127.0.0.1:1883

# Mosquitto provisioning (install-saas.sh reads these)
MOSQUITTO_ALLOW_ANONYMOUS=false
MOSQUITTO_USER=mooreview
MOSQUITTO_PASS=CHANGE_ME_before_production

# NextCentury Meters API (optional — used when driver email/password are blank in drivers.json)
# NEXTCENTURY_EMAIL=
# NEXTCENTURY_PASSWORD=
