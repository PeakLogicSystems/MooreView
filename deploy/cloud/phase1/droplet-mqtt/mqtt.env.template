# MooreVIEW Phase 1 — dedicated MQTT droplet (cloud-mqtt-atl1)
# Copy to /etc/mooreview/mqtt.env BEFORE install-mqtt-droplet.sh

MOOREVIEW_DOMAIN=mqtt.mooreview.io

MOSQUITTO_ALLOW_ANONYMOUS=false
MOSQUITTO_USER=mooreview
MOSQUITTO_PASS=CHANGE_ME_MQTT_PASSWORD

MOSQUITTO_TLS=true
MOSQUITTO_TLS_PORT=8883

# Plain :1883 stays open on VPC for SaaS / ingest hub clients (mooreview.conf listener).
