# MooreVIEW Phase 1 — MQTT on SaaS droplet (cloud 1)
# Copy to /etc/mooreview/mqtt.env BEFORE enable-saas-mqtt.sh

MOOREVIEW_DOMAIN=mooreview.io

MOSQUITTO_ALLOW_ANONYMOUS=false
MOSQUITTO_USER=mooreview
MOSQUITTO_PASS=CHANGE_ME_MQTT_PASSWORD

# Use TLS for field appliances (recommended after certbot on mooreview.io)
MOSQUITTO_TLS=true
MOSQUITTO_TLS_PORT=8883

# For lab only before TLS cert exists:
# MOSQUITTO_TLS=false
