[Unit]
Description=mooreVIEW archive server (zstd blob store)
After=network.target

[Service]
Type=simple
User=mooreview
Group=mooreview
EnvironmentFile=/etc/mooreview/archive.env
WorkingDirectory=/home/mooreview
ExecStart=/usr/bin/node /home/mooreview/deploy/cloud/archive-server/server.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/data/archive
PrivateTmp=true

[Install]
WantedBy=multi-user.target
