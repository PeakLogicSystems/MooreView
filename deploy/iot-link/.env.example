# MooreVIEW IOT-LINK pool appliance — environment
# Copy to /etc/mooreview/env (install.sh does this on first run)

# App
PORT=3090
MOOREVIEW_PORT=3090
MOOREVIEW_DEPLOYMENT=appliance
MOOREVIEW_PRODUCT=iot-link-pool
MOOREVIEW_TENANT_ID=local
MOOREVIEW_DATA=/var/lib/mooreview

# Compulab IOT-LINK RS-485 (FARS4=PORT A, FBRS4=PORT B)
MOOREVIEW_RS485_PORT_A=/dev/ttyLP6
MOOREVIEW_RS485_PORT_B=/dev/ttyLP4

# Pool feature flags (re-run seed-pool-config.js --force after changes)
MOOREVIEW_POOL_PENTAIR=true
MOOREVIEW_POOL_PENTAIR_BUS=true
MOOREVIEW_POOL_INTELLIFLO=true
MOOREVIEW_POOL_INTELLIFLO_ADDR=96
MOOREVIEW_POOL_INTELLIVALVE=true
MOOREVIEW_POOL_INTELLIVALVE_ADDR=12

# Jandy AquaLink RS-485 bus (mutually exclusive with Pentair/Hayward on PORT B)
# MOOREVIEW_POOL_JANDY_BUS=true
# MOOREVIEW_POOL_JANDY_EPUMP=true
# MOOREVIEW_POOL_JANDY_EPUMP_ADDR=120

# Hayward low-speed RS-485 bus (OmniLogic / AquaLogic VS pumps)
# MOOREVIEW_POOL_HAYWARD_BUS=true
# MOOREVIEW_POOL_HAYWARD_PUMP=true
# MOOREVIEW_POOL_HAYWARD_PUMP_HUA=0

MOOREVIEW_POOL_MODBUS_CHEM=false
MOOREVIEW_POOL_OPTA_IO=true

# MongoDB (local mongod)
MONGO_URL=mongodb://127.0.0.1:27017/mooreview
MONGODB_URI=mongodb://127.0.0.1:27017/mooreview
MOOREVIEW_CONFIG_URI=mongodb://127.0.0.1:27017/mooreview
MOOREVIEW_CONFIG_DB=mooreview_config
MONGODB_DB=mooreview

# MQTT broker (local Mosquitto — Opta Parc)
MOOREVIEW_MQTT_BROKER=mqtt://127.0.0.1:1883
MOSQUITTO_ALLOW_ANONYMOUS=false
MOSQUITTO_USER=mooreview
MOSQUITTO_PASS=change-me

# Match credentials in MooreVIEW System setup → MQTT Parc
# mqttParc.username=mooreview
# mqttParc.password=change-me

# Optional cloud uplink (System setup UI — not required on appliance)
# cloudRemote.enabled=true
# cloudRemote.tenantId=<tenant>
# cloudRemote.gatewayId=<uuid>
# cloudRemote.brokerUrl=mqtt://<cloud-host>:1883
