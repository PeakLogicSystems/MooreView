# MooreVIEW Res-Pool-Link — residential pool & spa + 4 IntelliValves
# Copy to /etc/mooreview/env  then:  node deploy/iot-link/seed-pool-config.js --force
# Guide: docs/RES_POOL_LINK.md

PORT=3090
MOOREVIEW_PORT=3090
MOOREVIEW_DEPLOYMENT=appliance
MOOREVIEW_PRODUCT=res-pool-link
MOOREVIEW_TENANT_ID=home
MOOREVIEW_DATA=/var/lib/mooreview

MOOREVIEW_POOL_PROFILE=res-pool-link
MOOREVIEW_POOL_SPA=true

# Compulab IOT-LINK — PORT B is the shared Pentair automation bus
MOOREVIEW_RS485_PORT_A=/dev/ttyLP6
MOOREVIEW_RS485_PORT_B=/dev/ttyLP4

# IntelliFlo (addr 96) + IntelliChlor on ONE RS-485 (9600 8N1)
MOOREVIEW_POOL_PENTAIR_BUS=true
MOOREVIEW_POOL_INTELLIFLO=true
MOOREVIEW_POOL_INTELLIFLO_ADDR=96
# Backwash valves are ESP32 relays (inlet / outlet / waste / spare), not IntelliValve
MOOREVIEW_POOL_ESP32_VALVES=true
MOOREVIEW_POOL_ESP32_VALVES_DEVICE_ID=res_pool_valves
MOOREVIEW_POOL_INTELLIVALVE=false
MOOREVIEW_POOL_PENTAIR=false
MOOREVIEW_POOL_MODBUS_CHEM=false
MOOREVIEW_POOL_OPTA_IO=false

# Home Wi-Fi satellites (commission each at http://192.168.4.1:8080/setup)
MOOREVIEW_POOL_WAVESHARE_RELAYS=spa_jets:ws_relay_spa,light_z1:ws_relay_lz1

# Hub process can stay on localhost 1883; ESP32 satellites use mqtts :8883
MOOREVIEW_MQTT_BROKER=mqtt://127.0.0.1:1883
# MOSQUITTO_TLS=true  → listener 8883 (see deploy/cloud/debian/mosquitto-tls.conf)
MOSQUITTO_ALLOW_ANONYMOUS=false
MOSQUITTO_USER=mooreview
MOSQUITTO_PASS=change-me
