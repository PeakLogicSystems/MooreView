[Unit]
Description=MooreVIEW IOT-LINK generic appliance
Documentation=file:/opt/mooreview/deploy/iot-link/README-generic.md
After=network-online.target mongod.service
Wants=network-online.target mongod.service

[Service]
Type=simple
User=mooreview
Group=mooreview
WorkingDirectory=@MOOREVIEW_INSTALL_DIR@
EnvironmentFile=-/etc/mooreview/env
Environment=NODE_OPTIONS=
Environment=NODE_ENV=production
Environment=MOOREVIEW_DEPLOYMENT=appliance
Environment=MOOREVIEW_PRODUCT=iot-link
Environment=PORT=3090
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=false
ReadWritePaths=/var/lib/mooreview @MOOREVIEW_INSTALL_DIR@
PrivateTmp=true
SupplementaryGroups=dialout

[Install]
WantedBy=multi-user.target
