[Unit]
Description=MooreVIEW Res-Pool-Link (residential pool & spa)
Documentation=file:/opt/mooreview/docs/RES_POOL_LINK.md
After=network-online.target mongod.service mosquitto.service
Wants=network-online.target
Requires=mongod.service mosquitto.service

[Service]
Type=simple
User=mooreview
Group=mooreview
WorkingDirectory=@MOOREVIEW_INSTALL_DIR@
EnvironmentFile=-/etc/mooreview/env
Environment=NODE_OPTIONS=
Environment=NODE_ENV=production
Environment=MOOREVIEW_DEPLOYMENT=appliance
Environment=MOOREVIEW_PRODUCT=res-pool-link
Environment=PORT=3090
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=false
ReadWritePaths=/var/lib/mooreview @MOOREVIEW_INSTALL_DIR@
PrivateTmp=true
SupplementaryGroups=dialout

[Install]
WantedBy=multi-user.target
