[Unit]
Description=MooreVIEW MVP Suite
After=network.target mongod.service

[Service]
Type=simple
WorkingDirectory=/opt/mooreview-mvp-suite
Environment=NODE_ENV=production
Environment=MOOREVIEW_PRODUCT=mvp-suite
Environment=MOOREVIEW_DATA=/var/lib/mooreview
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
