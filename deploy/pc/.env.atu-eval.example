# MooreVIEW PC — ATU cloud fleet evaluation
# Copy relevant lines into est-pc/.env for local demo (merge with .env.example)

PORT=3090
MOOREVIEW_PORT=3090
MOOREVIEW_DEPLOYMENT=cloud
MOOREVIEW_CLOUD_SIMS=1
MOOREVIEW_TENANT_ID=atu-cloud

# Local Mosquitto (npm run mqtt:start)
MOOREVIEW_MQTT_BROKER=mqtt://127.0.0.1:1883
MOOREVIEW_MQTT_ENABLED=true

# Optional MongoDB historian (PC install — not required for fleet eval)
# MONGODB_URI=mongodb://127.0.0.1:27017/mooreview

# Open projects:
#   atu-cloud-residential  — 500 GPD, 1 single ATU
#   atu-cloud-commercial   — 10,000 GPD, 4 quad ATU + 20 simplex lifts
#
# Simulated cellular devices:
#   npm run atu-fleet:sim -- --profile commercial
