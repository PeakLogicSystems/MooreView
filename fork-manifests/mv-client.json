{
  "name": "mooreview-client",
  "description": "MooreVIEW HMI + operator UI client (standalone browser)",
  "includeDirs": [
    "public",
    "views",
    "scripts"
  ],
  "includeFiles": [
    "package.json",
    "README.md"
  ],
  "excludeGlobs": [
    "src/**",
    "server.js",
    "st/**",
    "firmware/**",
    "data/**",
    "test/**",
    "fork-manifests/**",
    "product-templates/**",
    "public/hmi/svg/library/**",
    "scripts/download-*",
    "scripts/migrate-st-*"
  ],
  "excludeGlobsUnlessHmiAssets": [],
  "productTemplate": "mv-client"
}
