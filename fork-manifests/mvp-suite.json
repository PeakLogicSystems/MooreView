{
  "name": "mooreview-mvp-suite",
  "description": "All-in-one MooreVIEW for Windows and Linux — ST, runtime, HMI, historian, Parc",
  "includeDirs": [
    "src",
    "public",
    "views",
    "st",
    "test",
    "data",
    "scripts",
    "firmware",
    "docs",
    "mv-draw"
  ],
  "includeFiles": [
    "server.js",
    "package.json",
    "package-lock.json",
    "README.md"
  ],
  "excludeGlobs": [
    "fork-manifests/**",
    "product-templates/**",
    "node_modules/**"
  ],
  "productTemplate": "mvp-suite"
}
