{
  "name": "mooreview-opta-parc",
  "description": "Opta Parc operator UI — browser client pointed at mooreview.io cloud",
  "includeDirs": [
    "public",
    "views",
    "scripts"
  ],
  "includeFiles": [
    "package.json",
    "README.md"
  ],
  "excludeGlobs": [
    "src/**",
    "server.js",
    "st/**",
    "firmware/**",
    "data/**",
    "test/**",
    "fork-manifests/**",
    "product-templates/**",
    "public/hmi/svg/library/**",
    "scripts/download-*",
    "scripts/migrate-st-*"
  ],
  "excludeGlobsUnlessHmiAssets": [],
  "productTemplate": "opta-parc"
}
