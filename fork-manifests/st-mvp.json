{
  "name": "mooreview-st-mvp",
  "description": "ST programming + PLC runtime MVP for embedded Linux",
  "includeDirs": [
    "src/engine",
    "src/runtime",
    "src/tags",
    "src/drivers",
    "src/programs",
    "src/devices",
    "src/system",
    "src/graph",
    "src/hal",
    "src/api",
    "src/routes",
    "src/project",
    "src/hmi",
    "src/parc",
    "src/logger",
    "src/settings",
    "st",
    "test",
    "data",
    "hal",
    "docs"
  ],
  "includeFiles": [
    "src/config.js",
    "src/persistence.js",
    "package.json",
    "README.md"
  ],
  "excludeGlobs": [
    "src/api/routes/hmi.js",
    "src/api/routes/parc.js",
    "public/**",
    "views/**",
    "firmware/**",
    "scripts/download-*",
    "scripts/organize-hmi-*",
    "scripts/build-hmi-*",
    "scripts/strip-hmi-*",
    "fork-manifests/**",
    "product-templates/**",
    "docs/PRODUCT_FORKS.md"
  ],
  "productTemplate": "st-mvp"
}
