{
  "name": "mooreview-st-oem",
  "description": "MV-ST-OEM — OpenWrt + Pi OEM: ST program, tags, drivers, I/O map, HAL, C++ SDK",
  "includeDirs": [
    "src/engine",
    "src/runtime",
    "src/tags",
    "src/drivers",
    "src/programs",
    "src/devices",
    "src/appliance",
    "src/configStore",
    "src/system",
    "src/graph",
    "src/hal",
    "src/api",
    "src/routes",
    "src/project",
    "src/hmi",
    "src/parc",
    "src/logger",
    "src/settings",
    "mv-draw",
    "st",
    "test",
    "data",
    "hal",
    "native",
    "sdk",
    "docs"
  ],
  "includeFiles": [
    "src/config.js",
    "src/persistence.js",
    "src/programIoTags.js",
    "scripts/mqtt-broker-paths.js",
    "docs/OPENWRT.md",
    "package.json",
    "README.md"
  ],
  "excludeGlobs": [
    "src/api/routes/hmi.js",
    "src/api/routes/parc.js",
    "src/api/routes/project.js",
    "src/api/routes/alarms.js",
    "src/api/routes/reports.js",
    "src/api/routes/pdm.js",
    "src/api/routes/users.js",
    "src/api/routes/hardwareHistory.js",
    "src/api/routes/sysLog.js",
    "src/api/routes/cloudSims.js",
    "src/api/routes/cellularSims.js",
    "src/api/routes/messaging.js",
    "src/api/routes/projectHub.js",
    "mv-draw/src/api/**",
    "public/**",
    "views/**",
    "sdk/build/**",
    "halow-xiao-sta/**",
    "cellular-opta-gateway/**",
    "firmware/**",
    "scripts/download-*",
    "scripts/organize-hmi-*",
    "scripts/build-hmi-*",
    "scripts/strip-hmi-*",
    "fork-manifests/**",
    "product-templates/**",
    "docs/PRODUCT_FORKS.md"
  ],
  "productTemplate": "st-oem"
}
