[Unit]
Description=MooreVIEW SaaS platform
After=network.target mongod.service mosquitto.service

[Service]
Type=simple
User=mooreview
Group=mooreview
WorkingDirectory=/home/mooreview
EnvironmentFile=/etc/mooreview/saas.env
Environment=NODE_ENV=production
Environment=MOOREVIEW_DEPLOYMENT=cloud
Environment=MOOREVIEW_PRODUCT=cloud
Environment=MOOREVIEW_DATA=/var/lib/mooreview
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
