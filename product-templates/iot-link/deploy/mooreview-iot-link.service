[Unit]
Description=MooreVIEW IOT-LINK generic appliance
After=network-online.target mongod.service
Wants=network-online.target mongod.service

[Service]
Type=simple
WorkingDirectory=/opt/mooreview
EnvironmentFile=-/etc/mooreview/env
Environment=MOOREVIEW_DEPLOYMENT=appliance
Environment=MOOREVIEW_PRODUCT=iot-link
Environment=MOOREVIEW_DATA=/var/lib/mooreview
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=5
User=mooreview
Group=mooreview
SupplementaryGroups=dialout

[Install]
WantedBy=multi-user.target
