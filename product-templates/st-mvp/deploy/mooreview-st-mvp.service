[Unit]
Description=MooreVIEW ST MVP runtime
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/mooreview-st-mvp
Environment=NODE_ENV=production
Environment=MOOREVIEW_DATA=/var/lib/mooreview
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
