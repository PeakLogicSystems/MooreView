<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/st-mvp.css?v=<%= assetV %>">
</head>
<body>
  <header class="topbar">
    <div class="brand">
      <strong>MooreVIEW ST MVP</strong>
      <span class="muted">Linux programming &amp; runtime</span>
    </div>
    <div id="runtime-badge" class="badge badge-idle">—</div>
    <button type="button" id="btn-help" class="btn btn-ghost" title="F1">Help</button>
  </header>

  <nav class="tabs" id="main-tabs">
    <a href="#project" data-tab="project">Project</a>
    <a href="#program" data-tab="program">Program</a>
    <a href="#tags" data-tab="tags">Tags</a>
    <a href="#drivers" data-tab="drivers">Drivers</a>
    <a href="#runtime" data-tab="runtime">Runtime</a>
  </nav>

  <main id="app" class="app"></main>

  <dialog id="help-dialog" class="help-dialog">
    <header>
      <h2 id="help-title">Help</h2>
      <button type="button" id="help-close" class="btn btn-ghost" aria-label="Close">✕</button>
    </header>
    <nav id="help-nav" class="help-nav"></nav>
    <article id="help-body" class="help-body"></article>
  </dialog>

  <script src="/js/api.js?v=<%= assetV %>"></script>
  <script src="/js/help-st-mvp.js?v=<%= assetV %>"></script>
  <script src="/js/st-mvp-app.js?v=<%= assetV %>"></script>
</body>
</html>
