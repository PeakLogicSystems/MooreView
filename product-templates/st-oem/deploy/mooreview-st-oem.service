[Unit]
Description=MV-ST-OEM — MooreVIEW agnostic hardware programming
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/mooreview-st-oem
Environment=NODE_ENV=production
Environment=MOOREVIEW_PRODUCT=st-oem
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
