<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/st-oem.css?v=<%= assetV %>">
</head>
<body>
  <header class="topbar">
    <div class="brand">
      <strong>MV-ST-OEM</strong>
      <span class="muted">OpenWrt production · Pi HAL bench</span>
    </div>
    <div id="runtime-badge" class="badge badge-idle">—</div>
    <div class="runtime-mini">
      <button type="button" id="rt-start" class="btn btn-sm">Start</button>
      <button type="button" id="rt-stop" class="btn btn-sm btn-ghost">Stop</button>
    </div>
  </header>

  <nav class="tabs" id="main-tabs">
    <a href="#program" data-tab="program">Program</a>
    <a href="#tags" data-tab="tags">Tags</a>
    <a href="#drivers" data-tab="drivers">Drivers</a>
    <a href="#iomap" data-tab="iomap">I/O Map</a>
  </nav>

  <main id="app" class="app"></main>

  <script src="/js/api.js?v=<%= assetV %>"></script>
  <script src="/js/expansionIo.js?v=<%= assetV %>"></script>
  <script src="/js/st-oem-app.js?v=<%= assetV %>"></script>
</body>
</html>
