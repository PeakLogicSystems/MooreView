# Nexcomm Service Bus → MQTT bridge
# Copy to services/nexcomm-sb-mqtt-bridge/.env or inject via Container App / VM env

# --- Azure Service Bus (pick connection string OR managed identity namespace) ---
SERVICE_BUS_CONNECTION_STRING=
# SERVICE_BUS_NAMESPACE=your-namespace
SERVICE_BUS_QUEUE=nexcomm-telemetry

# Topic mode (optional — use instead of queue)
# SERVICE_BUS_TOPIC=nexcomm-telemetry
# SERVICE_BUS_SUBSCRIPTION=mooreview-bridge

# --- mooreVIEW Mosquitto ---
# Lab: local broker. Production cloud: mqtts://mqtt.mooreview.io:8883
MQTT_BROKER_URL=mqtt://127.0.0.1:1883
# MQTT_BROKER_URL=mqtts://mqtt.mooreview.io:8883
MQTT_USERNAME=mooreview
MQTT_PASSWORD=change-me
MQTT_CLIENT_ID=nexcomm-sb-bridge
MQTT_QOS=1
MQTT_RETAIN=false

# IoT Hub device protocol topic — must match lift_station_epi driver subscriptions
# Hyphenated Nexcomm serials (xxxx-xxxxxx) are normalized to compact lowercase
MQTT_EVENTS_TOPIC_TEMPLATE=/devices/{serial}/messages/events/

# --- Throughput / logging ---
BRIDGE_MAX_CONCURRENT=8
BRIDGE_LOG_EVERY_N=100
BRIDGE_HEALTH_LOG_INTERVAL_MS=60000
