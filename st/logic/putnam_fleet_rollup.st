IF YELV_X1_I1 THEN SetReal(YELV_TANK_LVL, 92.0);
ELSIF YELV_LVL_LAG2 THEN SetReal(YELV_TANK_LVL, 78.0);
ELSIF YELV_X1_I3 THEN SetReal(YELV_TANK_LVL, 68.0);
